#!/bin/bash
# Oche launcher: starts the save server quietly, then opens Oche in its own app window.
RES="$(cd "$(dirname "$0")/../Resources" && pwd)"
SUPPORT="$HOME/Library/Application Support/Oche"
mkdir -p "$SUPPORT"
LOG="$SUPPORT/oche.log"
PORT=8765
BASE="http://127.0.0.1:$PORT"

server_up() { /usr/bin/curl -s -m 1 "$BASE/api/matches" >/dev/null 2>&1; }

find_python() {
  for p in /opt/homebrew/bin/python3 /usr/local/bin/python3 \
           /Library/Frameworks/Python.framework/Versions/Current/bin/python3; do
    [ -x "$p" ] && { echo "$p"; return; }
  done
  # /usr/bin/python3 is only real once Apple's command line tools are installed
  if /usr/bin/xcode-select -p >/dev/null 2>&1 && [ -x /usr/bin/python3 ]; then echo /usr/bin/python3; fi
}

find_browser() {
  for b in "Google Chrome.app/Contents/MacOS/Google Chrome" \
           "Microsoft Edge.app/Contents/MacOS/Microsoft Edge" \
           "Brave Browser.app/Contents/MacOS/Brave Browser" \
           "Chromium.app/Contents/MacOS/Chromium"; do
    for dir in /Applications "$HOME/Applications"; do
      [ -x "$dir/$b" ] && { echo "$dir/$b"; return; }
    done
  done
}

STARTED=""
URL="$BASE/"
if ! server_up; then
  PY="$(find_python)"
  if [ -n "$PY" ]; then
    start_server() {
      OCHE_ROOT="$RES" OCHE_DATA_DIR="$SUPPORT" OCHE_PORT="$PORT" "$PY" "$1" >>"$LOG" 2>&1 &
      SERVER_PID=$!
      for i in $(seq 1 50); do server_up && return 0; sleep 0.1; done
      kill "$SERVER_PID" 2>/dev/null; return 1
    }
    # use an installed server update if there is one, falling back to the bundled server if it won't start
    if [ -f "$SUPPORT/server.py" ] && start_server "$SUPPORT/server.py"; then STARTED=1
    elif start_server "$RES/server.py"; then STARTED=1
    fi
  fi
  server_up || URL="file://$RES/oche.html"   # no Python: run straight from the file, saving inside the app window
fi

SIZE="$(/usr/bin/osascript -l JavaScript -e 'ObjC.import("AppKit"); const f=$.NSScreen.mainScreen.visibleFrame; Math.round(f.size.width)+","+Math.round(f.size.height)' 2>/dev/null)"
[ -z "$SIZE" ] && SIZE="1440,900"

BROWSER="$(find_browser)"
if [ -n "$BROWSER" ]; then
  "$BROWSER" --app="$URL" --user-data-dir="$SUPPORT/window" \
    --no-first-run --no-default-browser-check --disable-features=Translate \
    --autoplay-policy=no-user-gesture-required \
    --window-position=0,0 --window-size="$SIZE" >>"$LOG" 2>&1
  [ -n "$STARTED" ] && kill "$SERVER_PID" 2>/dev/null
else
  /usr/bin/open -a Safari "$URL"
fi
